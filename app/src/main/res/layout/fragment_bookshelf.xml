<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="读一点，懂多一点。" style="@style/SectionTitle"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="让故事带你走进另一种语言" style="@style/MutedText" android:layout_marginTop="8dp" android:layout_marginBottom="20dp"/>
    <TextView android:id="@+id/mode_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/soft_panel" style="@style/MutedText" android:layout_marginBottom="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="我的书架" android:textSize="20sp" android:textStyle="bold"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/import_book" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋ 导入 EPUB"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/loading" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center"/>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="32dp" android:gravity="center" style="@style/MutedText" android:text="书架还是空的
导入一本 EPUB，开始你的阅读" android:visibility="gone"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingTop="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="长按书籍可删除 · 阅读进度随读随记" style="@style/MutedText"/>
</LinearLayout>
