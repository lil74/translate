<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="让画面带你走进另一种语言" android:textSize="13sp" android:textColor="?attr/paletteMuted"/><com.google.android.material.button.MaterialButton android:id="@+id/import_video" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="＋ 导入"/></LinearLayout>
<ProgressBar android:id="@+id/video_library_loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center"/>
<TextView android:id="@+id/video_library_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:text="还没有视频" android:gravity="center" style="@style/MutedText" android:visibility="gone"/>
<com.google.android.material.button.MaterialButton android:id="@+id/video_library_retry" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="center" android:text="重试" android:visibility="gone"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/video_library_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="10dp" android:clipToPadding="false"/>
</LinearLayout>