<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/surface">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/selection_title" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink"/>
<TextView android:id="@+id/selection_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textSize="18sp" android:textColor="@color/ink" android:textIsSelectable="true"/>
<TextView android:id="@+id/selection_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="16dp" style="@style/MutedText"/>
<ProgressBar android:id="@+id/selection_spinner" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone"/>
<TextView android:id="@+id/selection_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="17sp" android:textColor="@color/translation" android:background="@drawable/soft_panel" android:textIsSelectable="true" android:accessibilityLiveRegion="polite"/>
<com.google.android.material.button.MaterialButton android:id="@+id/selection_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/selection_retry"/>
<com.google.android.material.button.MaterialButton android:id="@+id/selection_close" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/selection_close"/>
</LinearLayout></ScrollView>
