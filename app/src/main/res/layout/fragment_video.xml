<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/video_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/paletteBackground">
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <FrameLayout android:id="@+id/video_stage" android:layout_width="match_parent" android:layout_height="210dp" android:background="#000000">
   <androidx.media3.ui.PlayerView app:controller_layout_id="@layout/video_player_controls" android:id="@+id/video_player" android:layout_width="match_parent" android:layout_height="match_parent"/>
   <TextView android:id="@+id/video_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginBottom="56dp" android:gravity="center" android:padding="8dp" android:textColor="#FFFFFF" android:background="#99000000" android:textSize="16sp" android:visibility="gone" android:importantForAccessibility="no"/>

   <View android:id="@+id/video_subtitle_scrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:visibility="gone" android:clickable="true" android:focusable="true" android:contentDescription="关闭字幕侧栏"/>
   <include layout="@layout/video_subtitle_drawer"/>
  </FrameLayout>
  <TextView android:id="@+id/video_playback_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/primary" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/video_translate"
      android:layout_width="match_parent" android:layout_height="52dp"
      android:layout_marginHorizontal="16dp" android:text="翻译视频"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:gravity="center_vertical">
   <TextView android:id="@+id/video_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="12sp" android:textColor="?attr/paletteMuted" android:accessibilityLiveRegion="polite"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/video_cancel" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="取消处理" android:visibility="gone"/>
  </LinearLayout>
  <ProgressBar android:id="@+id/video_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:max="1000" android:visibility="gone"/>
  <TextView android:id="@+id/video_demo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:text="模拟译文，非真实翻译" android:textSize="12sp" android:textColor="?attr/palettePrimary" android:visibility="gone"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
   <androidx.recyclerview.widget.RecyclerView android:id="@+id/video_cues" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingHorizontal="8dp" android:paddingBottom="24dp"/>
  </FrameLayout>
 </LinearLayout>
</FrameLayout>
