<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/cloud_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="8dp" android:text="正在加载云端书库…"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/cloud_upload" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="上传本地书籍"/>
        <Button android:id="@+id/cloud_refresh" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="刷新"/>
    </LinearLayout>
    <ListView android:id="@+id/cloud_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
