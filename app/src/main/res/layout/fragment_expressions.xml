<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/expressions_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="8dp"
        android:text="正在读取收藏…"/>
    <Button android:id="@+id/expressions_sync_local" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="同步本机收藏到当前账号"
        android:visibility="gone"/>
    <ListView android:id="@+id/expressions_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
