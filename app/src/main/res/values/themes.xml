<resources>
    <style name="Theme.BilingualReader" parent="Theme.MaterialComponents.DayNight.NoActionBar"><item name="palettePrimary">@color/primary</item><item name="paletteBackground">@color/background</item><item name="paletteSurface">@color/surface</item><item name="paletteInk">@color/ink</item><item name="paletteMuted">@color/muted</item><item name="paletteSoft">@color/soft</item><item name="paletteTranslation">@color/translation</item>
        <item name="colorPrimary">?attr/palettePrimary</item><item name="colorPrimaryVariant">?attr/palettePrimary</item>
        <item name="colorSecondary">?attr/palettePrimary</item><item name="colorSurface">?attr/paletteSurface</item>
        <item name="colorOnPrimary">?attr/paletteBackground</item><item name="colorOnSurface">?attr/paletteInk</item>
        <item name="android:windowBackground">?attr/paletteBackground</item><item name="android:colorBackground">?attr/paletteBackground</item>
        <item name="android:textColorPrimary">?attr/paletteInk</item><item name="android:textColorSecondary">?attr/paletteMuted</item>
        <item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">?attr/paletteBackground</item><item name="android:navigationBarColor">?attr/paletteBackground</item>
    </style>
    <style name="SectionTitle"><item name="android:textSize">28sp</item><item name="android:textStyle">bold</item><item name="android:textColor">?attr/paletteInk</item></style>
    <style name="MutedText"><item name="android:textSize">14sp</item><item name="android:textColor">?attr/paletteMuted</item><item name="android:lineSpacingMultiplier">1.3</item></style>
    <style name="ReaderDockButton">
      <item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">match_parent</item>
      <item name="android:gravity">center</item><item name="android:textSize">14sp</item><item name="android:textColor">?attr/palettePrimary</item>
      <item name="android:background">?attr/selectableItemBackground</item><item name="android:clickable">true</item><item name="android:focusable">true</item>
    </style>
<style name="Theme.BilingualReader.Blue" parent="Theme.BilingualReader"><item name="palettePrimary">@color/blue_primary</item><item name="paletteBackground">@color/blue_background</item><item name="paletteSurface">@color/blue_surface</item><item name="paletteInk">@color/blue_ink</item><item name="paletteMuted">@color/blue_muted</item><item name="paletteSoft">@color/blue_soft</item><item name="paletteTranslation">@color/blue_translation</item></style><style name="Theme.BilingualReader.Brown" parent="Theme.BilingualReader"><item name="palettePrimary">@color/brown_primary</item><item name="paletteBackground">@color/brown_background</item><item name="paletteSurface">@color/brown_surface</item><item name="paletteInk">@color/brown_ink</item><item name="paletteMuted">@color/brown_muted</item><item name="paletteSoft">@color/brown_soft</item><item name="paletteTranslation">@color/brown_translation</item></style></resources>
