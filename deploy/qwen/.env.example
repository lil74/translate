# Copy to .env (ignored by Git). Configure locally; never paste keys into chat.
# Use the exact regional compatible-mode base URL from your Bailian console.
QWEN_BASE_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-mt-plus
DASHSCOPE_API_KEY=
# Independent APP-to-gateway access token; generate at least 24 random characters.
SERVICE_TOKEN=
# Optional JSON glossary. Use reviewed names/terms for your book.
TRANSLATION_TERMS_JSON=[]
